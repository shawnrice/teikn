{
  "name": "teikn",
  "version": "2.0.0-rc.1",
  "description": "Generate design tokens",
  "keywords": [
    "design",
    "design tokens",
    "design-systems"
  ],
  "homepage": "https://github.com/shawnrice/teikn#readme",
  "bugs": {
    "url": "https://github.com/shawnrice/teikn/issues"
  },
  "license": "MIT",
  "author": "Shawn Patrick Rice <rice@shawnrice.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shawnrice/teikn.git"
  },
  "bin": {
    "teikn": "lib/src/cli.js"
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "!lib/tsconfig.tsbuildinfo",
    "!lib/src/**/*.type-test.js",
    "!lib/src/**/*.type-test.d.ts",
    "!lib/src/fixtures"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./color": {
      "types": "./lib/src/TokenTypes/Color/index.d.ts",
      "import": "./lib/src/TokenTypes/Color/index.js"
    },
    "./builders": {
      "types": "./lib/src/builders.d.ts",
      "import": "./lib/src/builders.js"
    },
    "./generators": {
      "types": "./lib/src/Generators/index.d.ts",
      "import": "./lib/src/Generators/index.js"
    },
    "./storybook": {
      "types": "./lib/src/storybook/index.d.ts",
      "import": "./lib/src/storybook/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "generate-example": "bun example/example-usage.ts",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/ && oxfmt --write",
    "prepublishOnly": "tsc",
    "storybook": "storybook dev -p 6006",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:node": "vitest run",
    "test:update": "bun test --update-snapshots && vitest run --update"
  },
  "devDependencies": {
    "@storybook/react": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.5",
    "typescript": "7.1.0-beta",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
